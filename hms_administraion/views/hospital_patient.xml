<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ACTION -->
    <record id="action_hospital_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hospital.patient</field>
    </record>

    <!-- PATIENT FORM VIEW -->
    <record id="view_hospital_patient_form" model="ir.ui.view">
        <field name="name">hospital.patient.form</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <sheet>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>

                        <group>
                            <field name="patient_code"/>
                            <field name="dob"/>
                            <field name="age"/>
                            <field name="gender"/>
                            <field name="blood_group"/>
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="admitted_date"/>
                            <field name="is_insured"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Address">
                            <group>
                                <field name="street"/>
                                <field name="street2"/>
                                <field name="city"/>
                                <field name="state_id"/>
                                <field name="zip"/>
                                <field name="country_id"/>
                            </group>
                        </page>

                        <page string="Medical Notes">
                            <field name="note"/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- PATIENT LIST VIEW -->
    <record id="view_hospital_patient_tree" model="ir.ui.view">
        <field name="name">hospital.patient.list</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <list string="Patients">
                <field name="patient_code"/>
                <field name="name"/>
                <field name="gender"/>
                <field name="age"/>
                <field name="blood_group"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>


</odoo>
