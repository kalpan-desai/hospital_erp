<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_hms_lab_order" model="ir.sequence">
            <field name="name">Lab Order Sequence</field>
            <field name="code">hms.lab.order</field>
            <field name="prefix">LAB/ORD/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_hms_lab_report" model="ir.sequence">
            <field name="name">Lab Report Sequence</field>
            <field name="code">hms.lab.report</field>
            <field name="prefix">LAB/REP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
