<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_health_score_form" model="ir.ui.view">
        <field name="name">health.score.form</field>
        <field name="model">health.score</field>
        <field name="arch" type="xml">
            <form string="Health Score Dashboard">
                <sheet>
                    <div class="row">
                        <!-- Header / Large Score -->
                        <div class="col-12 text-center" style="margin-bottom: 20px;">
                            <h1 style="font-size: 3em;">Health Score: <field name="score" readonly="1" class="oe_inline"/></h1>
                            <h3>
                                <field name="health_category" widget="badge" 
                                       decoration-success="health_category == 'excellent'"
                                       decoration-warning="health_category == 'good'"
                                       decoration-danger="health_category == 'critical'"/>
                                | Trend: <field name="trend" readonly="1" class="oe_inline"/>
                            </h3>
                        </div>
                    </div>
                    
                    <div class="alert alert-info" role="status" invisible="risk_insights == False">
                        <h4 class="alert-heading">Risk Insights Panel</h4>
                        <field name="risk_insights" readonly="1" widget="text"/>
                    </div>
                    
                    <group string="Score Details">
                        <group>
                            <field name="patient_id" readonly="1"/>
                            <field name="last_updated" readonly="1"/>
                            <field name="case_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    
                    <separator string="Score Breakdown Penalty"/>
                    <group>
                        <field name="disease_score" readonly="1"/>
                        <field name="lab_score" readonly="1"/>
                        <field name="medication_score" readonly="1"/>
                        <field name="risk_score" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_health_score_list" model="ir.ui.view">
        <field name="name">health.score.list</field>
        <field name="model">health.score</field>
        <field name="arch" type="xml">
            <list string="Health Scores">
                <field name="patient_id"/>
                <field name="score" widget="progressbar"/>
                <field name="health_category" widget="badge" 
                       decoration-success="health_category == 'excellent'"
                       decoration-warning="health_category == 'good'"
                       decoration-danger="health_category == 'critical'"/>
                <field name="trend"/>
                <field name="last_updated"/>
            </list>
        </field>
    </record>

    <record id="action_health_score" model="ir.actions.act_window">
        <field name="name">Health Scores</field>
        <field name="res_model">health.score</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <menuitem id="menu_health_score_dash" name="Dashboard" parent="menu_hms_health_score_root" action="action_health_score" sequence="5"/>
</odoo>
